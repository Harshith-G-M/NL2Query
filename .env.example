# Copy to .env and edit. Never commit .env.

# --- security ---
SECRET_KEY=change-me-to-a-long-random-string      # python -c "import secrets;print(secrets.token_hex(32))"
ADMIN_EMAILS=you@example.com                      # these accounts can open /metrics/admin
POSTGRES_PASSWORD=nl2query

# --- LLM: pick ONE ---
# A) Local, free, private (needs `ollama serve` and `ollama pull qwen2.5-coder:7b`)
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5-coder:7b

# B) Hosted, for deployment (Groq has a free tier; any OpenAI-compatible API works)
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=your-key
# OPENAI_MODEL=llama-3.3-70b-versatile
# Set real prices (USD per million tokens) from your provider's pricing page to get cost tracking:
# PRICE_IN_PER_MTOK=0
# PRICE_OUT_PER_MTOK=0

# C) No LLM at all (UI/plumbing demo only; returns trivial SQL)
# LLM_PROVIDER=mock

# --- limits (defaults shown) ---
# MAX_ROWS=500
# QUERY_TIMEOUT_S=15
# MAX_UPLOAD_MB=10
# RATE_LIMIT_PER_MIN=30
# CORS_ORIGINS=https://your-frontend.onrender.com
